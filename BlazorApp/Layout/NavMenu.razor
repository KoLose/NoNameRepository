@using BlazorApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
<div class="brand"><a href="/">◈ <strong>SkillMate</strong></a><span>ПРОСТРАНСТВО ОБУЧЕНИЯ</span></div>
<nav aria-label="Основная навигация">
    <span class="nav-caption">МОЁ ПРОСТРАНСТВО</span>
    <AuthorizeView>
        <Authorized>
            @if (AuthService.RoleId == 2)
            {
                <NavLink href="mentor/courses">Мои курсы</NavLink>
                <NavLink href="mentor/other-courses">Другие курсы</NavLink>
            }
            else { <NavLink href="courses">Каталог курсов</NavLink> }
            @if (AuthService.RoleId == 1)
            {
                <NavLink href="progress">Мой прогресс</NavLink>
                <NavLink href="favorites">Избранное</NavLink>
                <NavLink href="answers">Мои ответы</NavLink>
            }
            <NavLink href="grades">Оценки</NavLink>
            @if (AuthService.RoleId is 2 or 3)
            {
                <span class="nav-caption">ПРЕПОДАВАНИЕ</span>
                <NavLink href="manage">Управление обучением</NavLink>
            }
            @if (AuthService.RoleId == 3)
            {
                <NavLink href="directories">Справочники</NavLink>
            }
            <span class="nav-caption">АККАУНТ</span>
            <NavLink href="profile">Мой профиль</NavLink>
            <button class="logout" @onclick="Logout">Выйти из аккаунта ↗</button>
        </Authorized>
        <NotAuthorized>
            <NavLink href="login">Вход</NavLink>
            <NavLink href="register">Регистрация</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>
<div class="sidebar-note">Маленькие шаги.<br /><strong>Большие возможности.</strong></div>
@code {
    private async Task Logout() { await AuthService.LogoutAsync(); Navigation.NavigateTo("/login"); }
}

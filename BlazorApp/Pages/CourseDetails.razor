@page "/courses/{Id:int}"
@attribute [Authorize]
@using BlazorApp.ApiRequest
@using BlazorApp.ApiRequest.Models
@using BlazorApp.Services
@inject ApiRequest Request
@inject AuthService AuthService

<PageTitle>@(string.IsNullOrWhiteSpace(course.name) ? "Курс" : course.name)</PageTitle>

<p><a href="/courses">Назад к каталогу</a></p>

@if (isLoading)
{
    <h1>Курс</h1>
    <p>Загрузка курса...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <h1>Курс</h1>
    <p>@errorMessage</p>
    <button type="button" @onclick="LoadCourse">Повторить</button>
}
else
{
    <h1>@course.name</h1>
    <p>@course.description</p>
    <p>Наставник: @course.mentorName</p>

    @if (isFavoriteLoading)
    {
        <p>Проверка избранного...</p>
    }
    else if (!favoriteStateLoaded)
    {
        <p>@favoriteMessage</p>
        <button type="button" @onclick="LoadFavoriteState">Повторить</button>
    }
    else
    {
        <button type="button" @onclick="ToggleFavorite" disabled="@isUpdatingFavorite">
            @(isUpdatingFavorite
                ? "Сохранение..."
                : isFavorite ? "Убрать из избранного" : "Добавить в избранное")
        </button>

        @if (!string.IsNullOrWhiteSpace(favoriteMessage))
        {
            <p>@favoriteMessage</p>
        }
    }

    <section>
        <h2>Прогресс</h2>

        @if (isProgressLoading)
        {
            <p>Загрузка прогресса...</p>
        }
        else if (!string.IsNullOrWhiteSpace(progressErrorMessage))
        {
            <p>@progressErrorMessage</p>
            <button type="button" @onclick="LoadProgress">Повторить</button>
        }
        else
        {
            <p>Завершено уроков: @courseProgress.completedLessons из @courseProgress.totalLessons</p>
            <progress value="@courseProgress.percent" max="100">@courseProgress.percent%</progress>
            <p>@courseProgress.percent%</p>
        }
    </section>

    <h2>Уроки</h2>

    @if (course.lessons.Count == 0)
    {
        <p>В этом курсе пока нет уроков.</p>
    }
    else
    {
        <ol>
            @foreach (var lesson in course.lessons.OrderBy(lesson => lesson.position))
            {
                <li @key="lesson.id">
                    <a href="@($"/lessons/{lesson.id}")">@lesson.name</a>
                    — @GetLessonStatus(lesson.id)
                </li>
            }
        </ol>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CourseItem course = new();
    private ProgressData courseProgress = new();
    private string errorMessage = "";
    private string progressErrorMessage = "";
    private string favoriteMessage = "";
    private bool isLoading = true;
    private bool isProgressLoading;
    private bool isFavoriteLoading;
    private bool isUpdatingFavorite;
    private bool favoriteStateLoaded;
    private bool isFavorite;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCourse();
    }

    private async Task LoadCourse()
    {
        isLoading = true;
        errorMessage = "";

        var response = await Request.GetCourse(Id);
        if (response.status)
        {
            course = response.course;
            await LoadProgress();
            await LoadFavoriteState();
        }
        else
        {
            course = new CourseItem();
            errorMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить курс. Проверьте доступность API."
                : response.message;
        }

        isLoading = false;
    }

    private async Task LoadProgress()
    {
        isProgressLoading = true;
        progressErrorMessage = "";

        var response = await Request.GetCourseProgress(Id, AuthService.Token);
        if (response.status)
        {
            courseProgress = response;
        }
        else
        {
            courseProgress = new ProgressData();
            progressErrorMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить прогресс."
                : response.message;
        }

        isProgressLoading = false;
    }

    private async Task LoadFavoriteState()
    {
        isFavoriteLoading = true;
        favoriteStateLoaded = false;
        favoriteMessage = "";

        var response = await Request.GetFavorites(AuthService.Token);
        if (response.status)
        {
            isFavorite = response.favorites.Any(favorite => favorite.courseId == Id);
            favoriteStateLoaded = true;
        }
        else
        {
            isFavorite = false;
            favoriteMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось проверить избранное."
                : response.message;
        }

        isFavoriteLoading = false;
    }

    private async Task ToggleFavorite()
    {
        if (isUpdatingFavorite || !favoriteStateLoaded)
            return;

        isUpdatingFavorite = true;
        favoriteMessage = "";

        var response = isFavorite
            ? await Request.RemoveFavorite(Id, AuthService.Token)
            : await Request.AddFavorite(Id, AuthService.Token);

        if (response.status)
        {
            isFavorite = !isFavorite;
            favoriteMessage = response.message;
        }
        else
        {
            favoriteMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось изменить избранное."
                : response.message;
        }

        isUpdatingFavorite = false;
    }

    private string GetLessonStatus(int lessonId)
    {
        if (!string.IsNullOrWhiteSpace(progressErrorMessage))
            return "Статус недоступен";

        return courseProgress.progress
            .FirstOrDefault(item => item.lessonId == lessonId)?.statusName
            ?? "Не начат";
    }
}

@page "/lessons/{Id:int}"
@attribute [Authorize]
@using BlazorApp.ApiRequest
@using BlazorApp.ApiRequest.Models
@using BlazorApp.Services
@inject ApiRequest Request
@inject AuthService AuthService

<PageTitle>@(string.IsNullOrWhiteSpace(lesson.name) ? "Урок" : lesson.name)</PageTitle>

@if (isLoading)
{
    <h1>Урок</h1>
    <p>Загрузка урока...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p><a href="/courses">Назад к каталогу</a></p>
    <h1>Урок</h1>
    <p>@errorMessage</p>
    <button type="button" @onclick="LoadLesson">Повторить</button>
}
else
{
    <p><a href="@($"/courses/{lesson.courseId}")">Назад к курсу</a></p>

    <h1>@lesson.name</h1>
    <p>Курс: @lesson.courseName</p>
    <p>Урок @lesson.position</p>

    <section>
        <h2>Прогресс</h2>

        @if (isProgressLoading)
        {
            <p>Загрузка прогресса...</p>
        }
        else
        {
            <p>Статус: @progressStatusName</p>

            <button type="button"
                    @onclick="StartLesson"
                    disabled="@(isUpdatingProgress || progressStatusId != StatusNotStarted)">
                Начать урок
            </button>
            <button type="button"
                    @onclick="CompleteLesson"
                    disabled="@(isUpdatingProgress || progressStatusId != StatusInProgress)">
                Завершить урок
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(progressMessage))
        {
            <p>@progressMessage</p>
        }
    </section>

    <section>
        <h2>Материал урока</h2>
        <p>@lesson.content</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(lesson.videoUrl))
    {
        <section>
            <h2>Видео</h2>
            <p>
                <a href="@lesson.videoUrl" target="_blank" rel="noopener noreferrer">
                    Открыть видео
                </a>
            </p>
        </section>
    }

    <section>
        <h2>Практические задания</h2>

        @if (CanManageAssignments)
        {
            <div>
                <h3>Новое задание</h3>

                <div>
                    <label for="new-assignment-name">Название</label>
                    <input id="new-assignment-name"
                           @bind="newAssignmentName"
                           disabled="@isCreatingAssignment" />
                </div>
                <div>
                    <label for="new-assignment-description">Описание</label>
                    <textarea id="new-assignment-description"
                              @bind="newAssignmentDescription"
                              disabled="@isCreatingAssignment"></textarea>
                </div>
                <div>
                    <label for="new-assignment-score">Максимальный балл</label>
                    <input id="new-assignment-score"
                           type="number"
                           min="1"
                           @bind="newAssignmentMaxScore"
                           disabled="@isCreatingAssignment" />
                </div>
                <div>
                    <label for="new-assignment-position">Позиция</label>
                    <input id="new-assignment-position"
                           type="number"
                           min="1"
                           @bind="newAssignmentPosition"
                           disabled="@isCreatingAssignment" />
                </div>

                <button type="button"
                        @onclick="CreateAssignment"
                        disabled="@isCreatingAssignment">
                    @(isCreatingAssignment ? "Создание..." : "Создать задание")
                </button>

                @if (!string.IsNullOrWhiteSpace(assignmentActionMessage))
                {
                    <p>@assignmentActionMessage</p>
                }
            </div>
        }

        @if (areAssignmentsLoading)
        {
            <p>Загрузка заданий...</p>
        }
        else if (!string.IsNullOrWhiteSpace(assignmentsErrorMessage))
        {
            <p>@assignmentsErrorMessage</p>
            <button type="button" @onclick="LoadAssignments">Повторить</button>
        }
        else if (assignments.Count == 0)
        {
            <p>Для этого урока заданий пока нет.</p>
        }
        else
        {
            <ol>
                @foreach (var assignment in assignments)
                {
                    <li @key="assignment.id">
                        <a href="@($"/assignments/{assignment.id}")">@assignment.name</a>
                        — максимум @assignment.maxScore баллов
                    </li>
                }
            </ol>
        }
    </section>

    <section>
        <h2>Комментарии</h2>

        @if (areCommentsLoading)
        {
            <p>Загрузка комментариев...</p>
        }
        else if (!string.IsNullOrWhiteSpace(commentsErrorMessage))
        {
            <p>@commentsErrorMessage</p>
            <button type="button" @onclick="LoadComments">Повторить</button>
        }
        else if (comments.Count == 0)
        {
            <p>Комментариев пока нет.</p>
        }
        else
        {
            @foreach (var comment in comments)
            {
                <article @key="comment.id">
                    <p><strong>@comment.userName</strong></p>
                    <p>@comment.content</p>
                    <p>@FormatCommentDate(comment.createdAt)</p>
                </article>
            }
        }

        <div>
            <label for="new-comment">Новый комментарий</label>
            <textarea id="new-comment"
                      maxlength="2000"
                      @bind="newCommentContent"
                      disabled="@isSendingComment"></textarea>
        </div>
        <button type="button" @onclick="SendComment" disabled="@isSendingComment">
            @(isSendingComment ? "Отправка..." : "Отправить")
        </button>

        @if (!string.IsNullOrWhiteSpace(commentActionMessage))
        {
            <p>@commentActionMessage</p>
        }
    </section>
}

@code {
    private const int StatusNotStarted = 1;
    private const int StatusInProgress = 2;
    private const int StatusCompleted = 3;
    private const int RoleMentor = 2;
    private const int RoleAdmin = 3;

    [Parameter]
    public int Id { get; set; }

    private LessonItem lesson = new();
    private string errorMessage = "";
    private string progressMessage = "";
    private string commentsErrorMessage = "";
    private string assignmentsErrorMessage = "";
    private string assignmentActionMessage = "";
    private string commentActionMessage = "";
    private string newCommentContent = "";
    private List<CommentItem> comments = new();
    private List<AssignmentItem> assignments = new();
    private bool isLoading = true;
    private bool isProgressLoading;
    private bool isUpdatingProgress;
    private bool areCommentsLoading;
    private bool areAssignmentsLoading;
    private bool isCreatingAssignment;
    private bool isSendingComment;
    private string newAssignmentName = "";
    private string newAssignmentDescription = "";
    private int newAssignmentMaxScore = 1;
    private int newAssignmentPosition = 1;
    private int progressStatusId = StatusNotStarted;
    private string progressStatusName = "Не начат";

    private bool CanManageAssignments =>
        AuthService.RoleId == RoleAdmin ||
        AuthService.RoleId == RoleMentor && lesson.courseMentorId == AuthService.UserId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadLesson();
    }

    private async Task LoadLesson()
    {
        isLoading = true;
        errorMessage = "";
        assignmentActionMessage = "";
        newAssignmentName = "";
        newAssignmentDescription = "";
        newAssignmentMaxScore = 1;
        newAssignmentPosition = 1;

        var response = await Request.GetLesson(Id);
        if (response.status)
        {
            lesson = response.lesson;
            await LoadProgress();
            await LoadAssignments();
            await LoadComments();
        }
        else
        {
            lesson = new LessonItem();
            errorMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить урок. Проверьте доступность API."
                : response.message;
        }

        isLoading = false;
    }

    private async Task LoadProgress()
    {
        isProgressLoading = true;

        var response = await Request.GetCourseProgress(lesson.courseId, AuthService.Token);
        if (response.status)
        {
            var lessonProgress = response.progress.FirstOrDefault(item => item.lessonId == Id);
            progressStatusId = lessonProgress?.statusId ?? StatusNotStarted;
            progressStatusName = lessonProgress?.statusName ?? "Не начат";
        }
        else
        {
            progressStatusId = StatusNotStarted;
            progressStatusName = "Не удалось загрузить статус";
            progressMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить прогресс."
                : response.message;
        }

        isProgressLoading = false;
    }

    private async Task StartLesson()
    {
        if (isUpdatingProgress || progressStatusId != StatusNotStarted)
            return;

        isUpdatingProgress = true;
        progressMessage = "";

        var response = await Request.StartLesson(Id, AuthService.Token);
        progressMessage = response.status
            ? response.message
            : string.IsNullOrWhiteSpace(response.message) ? "Не удалось начать урок." : response.message;

        if (response.status)
            await LoadProgress();

        isUpdatingProgress = false;
    }

    private async Task CompleteLesson()
    {
        if (isUpdatingProgress || progressStatusId != StatusInProgress)
            return;

        isUpdatingProgress = true;
        progressMessage = "";

        var response = await Request.CompleteLesson(Id, AuthService.Token);
        progressMessage = response.status
            ? response.message
            : string.IsNullOrWhiteSpace(response.message) ? "Не удалось завершить урок." : response.message;

        if (response.status)
            await LoadProgress();

        isUpdatingProgress = false;
    }

    private async Task LoadAssignments()
    {
        areAssignmentsLoading = true;
        assignmentsErrorMessage = "";

        var response = await Request.GetAssignmentsByLesson(Id);
        if (response.status)
        {
            assignments = response.assignments
                .OrderBy(assignment => assignment.position)
                .ToList();
            newAssignmentPosition = assignments.Count == 0
                ? 1
                : assignments.Max(assignment => assignment.position) + 1;
        }
        else
        {
            assignments.Clear();
            assignmentsErrorMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить задания."
                : response.message;
        }

        areAssignmentsLoading = false;
    }

    private async Task CreateAssignment()
    {
        if (isCreatingAssignment || !CanManageAssignments)
            return;

        var name = newAssignmentName.Trim();
        var description = newAssignmentDescription.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            assignmentActionMessage = "Введите название задания.";
            return;
        }

        if (newAssignmentMaxScore <= 0)
        {
            assignmentActionMessage = "Максимальный балл должен быть больше нуля.";
            return;
        }

        if (newAssignmentPosition <= 0)
        {
            assignmentActionMessage = "Позиция должна быть больше нуля.";
            return;
        }

        isCreatingAssignment = true;
        assignmentActionMessage = "";

        var response = await Request.CreateAssignment(new AssignmentDataShort
        {
            lessonId = Id,
            name = name,
            description = description,
            maxScore = newAssignmentMaxScore,
            position = newAssignmentPosition
        }, AuthService.Token);

        if (response.status)
        {
            newAssignmentName = "";
            newAssignmentDescription = "";
            newAssignmentMaxScore = 1;
            await LoadAssignments();
            assignmentActionMessage = "Задание создано.";
        }
        else
        {
            assignmentActionMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось создать задание."
                : response.message;
        }

        isCreatingAssignment = false;
    }

    private async Task LoadComments()
    {
        areCommentsLoading = true;
        commentsErrorMessage = "";

        var response = await Request.GetComments(Id, AuthService.Token);
        if (response.status)
        {
            comments = response.comments
                .OrderBy(comment => comment.createdAt)
                .ToList();
        }
        else
        {
            comments.Clear();
            commentsErrorMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось загрузить комментарии."
                : response.message;
        }

        areCommentsLoading = false;
    }

    private async Task SendComment()
    {
        if (isSendingComment)
            return;

        var content = newCommentContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            commentActionMessage = "Введите текст комментария.";
            return;
        }

        if (content.Length > 2000)
        {
            commentActionMessage = "Комментарий не должен превышать 2000 символов.";
            return;
        }

        isSendingComment = true;
        commentActionMessage = "";

        var response = await Request.AddComment(
            Id,
            new CommentRequest { content = content },
            AuthService.Token);

        if (response.status)
        {
            comments.Add(response.comment);
            newCommentContent = "";
            commentsErrorMessage = "";
            commentActionMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Комментарий отправлен."
                : response.message;
        }
        else
        {
            commentActionMessage = string.IsNullOrWhiteSpace(response.message)
                ? "Не удалось отправить комментарий."
                : response.message;
        }

        isSendingComment = false;
    }

    private static string FormatCommentDate(DateTime date) =>
        date.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
}
